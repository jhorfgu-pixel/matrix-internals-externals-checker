foreach ($n in $names) {
  $e = Name-Rx $n
  if ($genericNames -contains $n) { $nameRx[$n] = "(?i)^$e$stemTail$" } else { $nameRx[$n] = "(?i)(?<![A-Za-z0-9])$e$tokTail" }
}
function Test-Hit($s) { $s = "$s"; ($s -match $pattern) -and ($s -notmatch $exclude) }
function Match-Leaf($leaf, [bool]$allowNoExt) {
  $leaf = "$leaf".Trim().Trim('"')
  if (-not $leaf) { return $null }
  if ($leaf -match '^(.*?)-[0-9A-F]{8}\.pf$') { $leaf = $Matches[1] }
  $ext = if ($leaf -match '\.([^.\\/]{1,5})$') { $Matches[1] } else { '' }
  $stem = if ($ext) { $leaf.Substring(0, $leaf.Length - $ext.Length - 1) } else { $leaf }
  if ($ext) { if ($ext -notmatch "^(?:$execExt)$") { return $null } }
  elseif (-not $allowNoExt) { return $null }
  foreach ($n in $names) { if ($stem -match $nameRx[$n]) { return $n } }
  $null
}
