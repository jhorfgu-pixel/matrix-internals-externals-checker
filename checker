$gCore   = ($gNames  | ForEach-Object { Name-Rx $_ }) -join '|'
$scanParts = New-Object System.Collections.Generic.List[string]
if ($ngCore) { $scanParts.Add("(?<![A-Za-z0-9])(?:$ngCore)$tokTail") }
if ($gCore)  { $scanParts.Add("^(?:$gCore)$stemTail$") }
