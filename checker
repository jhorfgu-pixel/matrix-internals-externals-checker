$stemTail = "(?:[-_. ]*(?:$suffix|v?\d[\d.]*|x?64|x?86|win(?:32|64))|[-_. ]+x)*"
$tokTail  = "(?:(?![A-Za-z])|(?=(?:$suffix)(?![A-Za-z])))"
